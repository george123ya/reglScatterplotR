{
  "name": "reglscatterplot-js",
  "version": "0.99.1",
  "private": true,
  "type": "module",
  "description": "Build sources for the reglScatterplot widget (R htmlwidget + Python anywidget). All browser deps are bundled locally - no CDN at runtime.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "patch-package": "^8.0.1",
    "puppeteer-core": "^25.1.0"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.1",
    "regl-scatterplot": "1.14.1"
  }
}
